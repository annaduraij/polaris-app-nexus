{
  "name": "@polaris/design-system",
  "version": "1.0.6",
  "type": "module",
  "description": "Framework-independent design contracts, engines, labs and components",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./labs": { "types": "./src/labs.d.ts", "default": "./src/labs.js" },
    "./react": { "types": "./src/react.d.ts", "default": "./src/react.js" },
    "./styles.css": "./src/styles.css",
    "./profiles": { "types": "./generated/profiles.d.ts", "default": "./generated/profiles.js" },
    "./content": { "types": "./generated/content.d.ts", "default": "./generated/content.js" },
    "./developer-fonts": { "types": "./generated/developer-fonts.d.ts", "default": "./generated/developer-fonts.js" },
    "./contracts/*": "./contracts/*"
  },
  "files": ["src", "generated", "contracts", "assets", "README.md", "INTEGRATION.md"],
  "sideEffects": ["**/*.css"]
}
