{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polaris-app-nexus",
  "main": "./worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "ajay.nexus/*", "zone_name": "ajay.nexus" },
    { "pattern": "polaris.ajay.nexus/*", "zone_name": "ajay.nexus" }
  ]
}
